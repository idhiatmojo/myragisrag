# ==============================================================================
# PIPELINE RAG LITERATURE GAP MATRIX - MULTI-MODEL LLM CONFIGURATION
# ==============================================================================
# Pilih provider yang ingin digunakan:
# Nilai yang valid: gemini | grok | huggingface | openai | ollama | deepseek | openrouter | custom
LLM_PROVIDER=gemini

# ==============================================================================
# 1. Google Gemini (Gratis: https://aistudio.google.com/app/apikey)
# ==============================================================================
GEMINI_API_KEY=masukkan_api_key_gemini_anda_disini
# Model pilihan: gemini-3.1-flash-lite | gemini-flash-latest | gemini-pro-latest
GEMINI_LLM_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
USE_GEMINI_EMBEDDINGS=false

# ==============================================================================
# 2. xAI Grok (Dapatkan di: https://console.x.ai/)
# ==============================================================================
GROK_API_KEY=masukkan_api_key_grok_anda_disini
# Model pilihan: grok-2-latest | grok-2-1212 | grok-beta | grok-vision-beta
GROK_LLM_MODEL=grok-2-latest
GROK_BASE_URL=https://api.x.ai/v1

# ==============================================================================
# 3. Hugging Face (Dapatkan token di: https://huggingface.co/settings/tokens)
# ==============================================================================
HUGGINGFACE_API_KEY=masukkan_token_hf_anda_disini
# Model pilihan rekomendasi:
# - meta-llama/Llama-3.1-70B-Instruct
# - meta-llama/Llama-3.1-8B-Instruct
# - Qwen/Qwen2.5-72B-Instruct
# - mistralai/Mistral-7B-Instruct-v0.3
# - deepseek-ai/DeepSeek-R1-Distill-Qwen-32B
HUGGINGFACE_LLM_MODEL=meta-llama/Llama-3.1-70B-Instruct
HUGGINGFACE_BASE_URL=https://router.huggingface.co/hf-inference/v1

# ==============================================================================
# 4. OpenAI (Dapatkan di: https://platform.openai.com/api-keys)
# ==============================================================================
OPENAI_API_KEY=masukkan_api_key_openai_anda_disini
# Model pilihan: gpt-4o-mini | gpt-4o | o3-mini
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ==============================================================================
# 5. Local Ollama (Gratis & Offline: https://ollama.com)
# ==============================================================================
# Pastikan Ollama service berjalan (ollama serve)
OLLAMA_BASE_URL=http://localhost:11434/v1
# Model yang sudah di-pull (misal: ollama run llama3.1)
OLLAMA_LLM_MODEL=llama3.1

# ==============================================================================
# 6. DeepSeek (Dapatkan di: https://platform.deepseek.com)
# ==============================================================================
DEEPSEEK_API_KEY=masukkan_api_key_deepseek_anda_disini
DEEPSEEK_LLM_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ==============================================================================
# 7. OpenRouter (Multi-model aggregator: https://openrouter.ai/keys)
# ==============================================================================
OPENROUTER_API_KEY=masukkan_api_key_openrouter_anda_disini
OPENROUTER_LLM_MODEL=google/gemini-2.5-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ==============================================================================
# 8. Custom / Self-Hosted OpenAI-Compatible Server (vLLM / LM Studio / TextGen)
# ==============================================================================
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_MODEL=
CUSTOM_LLM_BASE_URL=http://localhost:8000/v1
